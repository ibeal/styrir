# Hatchet worker credentials. From `hatchet server start` (dashboard banner) or
# `hatchet profile` for the local profile.
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_CLIENT_HOST_PORT=localhost:7077

# Where styrir.config.json lives. Defaults to ./styrir.config.json.
# STYRIR_CONFIG=/Users/ian.beal/repos/styrir/hatchet/styrir.config.json

# SKALD_STORE / HEIMR_ROOT / GARDR_ROOT are inherited from the shell that
# starts the worker; the worker never sets them.
