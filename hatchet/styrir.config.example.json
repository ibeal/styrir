{
  "maxReviewRounds": 3,
  "maxBuildContinuations": 2,
  "maxConcurrentSandboxes": 2,
  "pollIntervalSeconds": 30,
  "models": {
    "defaultProvider": "anthropic",
    "defaultComplexity": { "building": 2, "reviewing": 1 },
    "tiers": {
      "anthropic": ["claude-haiku-4-5", "claude-sonnet-4-5", "claude-sonnet-4-5", "claude-opus-4-1"],
      "openai": ["gpt-5-mini", "gpt-5", "gpt-5", "gpt-5-pro"]
    }
  },
  "repos": {
    "styrir": {
      "checkout": "/Users/ian.beal/repos/styrir",
      "pushUrl": "git@github.com:ibeal/styrir.git",
      "trunk": "main",
      "buildSpec": "styrir-building-v2",
      "reviewSpec": "styrir-reviewing",
      "verify": "cargo test && cargo clippy -- -D warnings",
      "forge": "github",
      "defaultComplexity": { "building": 3 }
    },
    "Elevate": {
      "checkout": "/Users/ian.beal/repos/ap/Elevate",
      "pushUrl": "https://dev.azure.com/anglepoint/Elevate/_git/Elevate",
      "trunk": "master",
      "forge": "azure-devops",
      "buildSpec": "elevate-building",
      "reviewSpec": "dotnet-reviewing",
      "verify": "dotnet build AP.SAMPortal.sln && dotnet test AP.SAMPortal.sln"
    },
    "terraform": {
      "checkout": "/Users/ian.beal/repos/ap/terraform",
      "pushUrl": "https://github.com/Anglepoint-Engineering/terraform.git",
      "trunk": "main",
      "forge": "github",
      "buildSpec": "terraform-building",
      "reviewSpec": "terraform-reviewing",
      "verify": "terraform fmt -check -recursive && (cd <changed module or environment> && terraform init -backend=false && terraform validate)"
    }
  }
}
