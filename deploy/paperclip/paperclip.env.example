# Copy this file to paperclip.env (git-ignored) and fill in the secret
# values before running scripts/up.sh. This file is sourced into the
# environment of the `paperclipai` process running on the host — it is
# NOT passed to Docker; only PostgreSQL runs in a container here (see
# README.md for why).
#
# Nothing in this file's *committed example* form is a working credential.
# A fresh clone of this repository contains no credential: paperclip.env
# itself never gets committed (see ../../.gitignore).

# ---------------------------------------------------------------------------
# Network exposure: tailnet-only, human login required.
# ---------------------------------------------------------------------------
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_BIND=tailnet
# PORT=3100   # default; uncomment only if 3100 is taken on the laptop.

# If the phone/other devices reach this host by a custom Tailscale
# MagicDNS name or a manually-added hostname, list it here too (comma
# separated). Otherwise leave unset; the detected tailnet address/hostname
# is allowed automatically. See upstream-tailscale-private-access.md /
# `paperclipai allowed-hostname`.
# PAPERCLIP_ALLOWED_HOSTNAMES=my-macbook.tailnet-name.ts.net

# ---------------------------------------------------------------------------
# Standalone PostgreSQL (docker-compose.postgres.yml), not the embedded DB.
# Must match postgres.env's POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB and
# POSTGRES_HOST_PORT.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://paperclip:REPLACE_ME_WITH_A_LONG_RANDOM_VALUE@127.0.0.1:55432/paperclip

# ---------------------------------------------------------------------------
# Auth / signing secrets. Generate with: openssl rand -hex 32
# Required for `authenticated` mode; never commit real values.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=REPLACE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=REPLACE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ---------------------------------------------------------------------------
# Secrets provider. Authenticated deployments default this to true already;
# it is set explicitly here so the posture check has something to read and
# so the choice is not silently dependent on an upstream default.
# ---------------------------------------------------------------------------
PAPERCLIP_SECRETS_STRICT_MODE=true

# The local secrets master key is intentionally NOT set here. It stays at
# its default path (~/.paperclip/instances/default/secrets/master.key),
# auto-created on first onboarding with 0600 permissions, and is backed up
# by the operator outside of this repository. See README.md "Secrets master
# key" for the reasoning; automated backup is slice 4's job, not this one.
# PAPERCLIP_SECRETS_MASTER_KEY_FILE=

# ---------------------------------------------------------------------------
# Egress lockdown: every content-bearing and content-free channel off.
# ---------------------------------------------------------------------------
# Product telemetry: belt (env var) and braces (instance config; see
# README.md "Verifying the lockdown by hand" for the config.json check).
PAPERCLIP_TELEMETRY_DISABLED=1

# Feedback-trace sharing: default denied AND floored so the UI control
# cannot re-enable it (rejects value-changing writes with
# 403 settings_operator_managed). Both lines are required — a default
# alone is user-overridable.
# Single-quoted on purpose: this file is *sourced* by scripts/pc.sh and
# scripts/up.sh, and the shell would otherwise strip the JSON's double quotes,
# leaving invalid JSON that Paperclip refuses to start on.
PAPERCLIP_SETTING_DEFAULTS='{"feedbackDataSharingPreference":"not_allowed"}'
PAPERCLIP_HIDDEN_SETTINGS=instance.general.feedbackDataSharingPreference

# Sentry (crash reporting) and OpenTelemetry (tracing) are opt-in upstream:
# leaving them unset is sufficient, but the variable names are listed here,
# commented out, so nobody accidentally sets one later without noticing
# what it does.
# SENTRY_DSN=
# SENTRY_DSN_FRONTEND=
# SENTRY_DSN_BACKEND=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# No model-provider credentials in this deployment. Slice 3's Gardr
# sandboxes do model execution, not this instance. Do not add any of:
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY
# The posture check fails loudly if any of these are present in the
# running process's environment.
# ---------------------------------------------------------------------------
