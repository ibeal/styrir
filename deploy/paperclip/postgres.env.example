# Copy this file to postgres.env (git-ignored) and fill in real values.
# postgres.env is read by docker-compose.postgres.yml via env_file.

POSTGRES_USER=paperclip
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_VALUE
POSTGRES_DB=paperclip

# Host-side port the container publishes on 127.0.0.1. Change only if 5432
# is already taken on the laptop; keep it loopback-only either way.
POSTGRES_HOST_PORT=5432
