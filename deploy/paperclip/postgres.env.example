# Copy this file to postgres.env (git-ignored) and fill in real values.
# postgres.env is read by docker-compose.postgres.yml via env_file.

POSTGRES_USER=paperclip
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_VALUE
POSTGRES_DB=paperclip

# Host-side port the container publishes on 127.0.0.1. 5432 is already taken
# on this laptop by the elevate-x-local stack, so this deployment uses 55432.
# Keep it loopback-only whatever you choose, and keep DATABASE_URL in
# paperclip.env in step with it.
POSTGRES_HOST_PORT=55432
